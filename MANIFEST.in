# The runtime wheel remains package-only.  The source distribution additionally carries the
# operator-facing registry/service contracts and the bounded repository utilities needed to inspect
# legacy experiments, reproduce the checked OpenAPI document, and verify release archives.
include docs/adr/0002-durable-local-registry.md
include docs/adr/0003-local-read-only-evidence-api.md
include docs/api/openapi-v1.json
include docs/api_service.md
include docs/run_registry.md
include scripts/generate_service_openapi.py
include scripts/summarize_experiments.py
include scripts/verify_distributions.py

global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude __pycache__
